{
  "name": "im",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "api:fetch-schema": "curl -sS https://immo-b89b.onrender.com/docs/v1-json -o swagger.json",
    "api:types": "openapi-typescript swagger.json -o app/types/api.d.ts",
    "api:sync": "npm run api:fetch-schema && npm run api:types",
    "api:check": "npm run api:fetch-schema && npm run api:types && git diff --exit-code -- app/types/api.d.ts swagger.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nuxt": "^4.4.8",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.1"
  }
}
